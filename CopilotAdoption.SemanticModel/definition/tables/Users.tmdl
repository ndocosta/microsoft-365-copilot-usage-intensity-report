table Users
	lineageTag: c2000000-0000-4000-8000-000000000001

	measure 'Total Users' = COUNTROWS('Users')
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: f033df9a-93d5-48d0-b5d5-089c9bad2d04

	measure 'High Adoption Users' = CALCULATE([Total Users], 'Users'[PromptsAllApps] >= 30)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 8a2314b3-91c8-424a-b65f-3ba4679a2aad

	measure 'Developing Users' = CALCULATE([Total Users], 'Users'[PromptsAllApps] >= 10, 'Users'[PromptsAllApps] < 30)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 1bff5b69-1b50-4913-84c8-46a0d31588b3

	measure 'Low Adoption Users' = CALCULATE([Total Users], 'Users'[PromptsAllApps] < 10)
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: 5685a412-fa56-4efe-8e8a-3900719c03a2

	measure 'Active Users' = CALCULATE([Total Users], NOT ISBLANK('Users'[LastActivityDate]))
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: b8b7883a-5350-43b1-bc5d-abdec2ee0a54

	measure 'Total Prompts' = SUM('Users'[PromptsAllApps])
		formatString: #,##0
		displayFolder: KPIs
		lineageTag: edf1a26f-4d53-479b-8186-fbddd2e3f0bf

	measure 'Average Prompts per User' = DIVIDE([Total Prompts], [Total Users])
		formatString: #,##0.0
		displayFolder: KPIs
		lineageTag: ab75d80f-6392-4799-97a2-dad468c97b07

	measure 'High Adoption Rate' = DIVIDE([High Adoption Users], [Total Users])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: d18831e2-e82d-47f5-9874-2abe7151411a

	measure 'Selected User' = SELECTEDVALUE('Users'[DisplayName], "Select one user")
		displayFolder: Profile
		lineageTag: 89debbb0-477e-4aa5-9874-23af57338531

	measure 'Selected Segment' = SELECTEDVALUE('Users'[UsageSegment], "Multiple users")
		displayFolder: Profile
		lineageTag: 88f287f0-5304-4a7b-8078-3d4c65fa697c

	measure 'Selected Prompts' = SELECTEDVALUE('Users'[PromptsAllApps])
		formatString: #,##0
		displayFolder: Profile
		lineageTag: b33276ab-032c-4e2a-9555-479c37490c09

	measure 'Selected Active Days' = SELECTEDVALUE('Users'[ActiveUsageDays])
		formatString: #,##0
		displayFolder: Profile
		lineageTag: 56327051-7572-4037-ab7d-bc26553a90bb

	measure 'Selected Department' = SELECTEDVALUE('Users'[Department], "Not available")
		displayFolder: Profile
		lineageTag: 8a59596d-0554-47c0-a470-0d3c7acc5c89

	measure 'Selected Job Title' = SELECTEDVALUE('Users'[JobTitle], "Not available")
		displayFolder: Profile
		lineageTag: c7cfa640-279e-4b60-a273-3741063a6238

	measure 'Selected Office' = SELECTEDVALUE('Users'[OfficeLocation], "Not available")
		displayFolder: Profile
		lineageTag: 70785e00-d3ec-489c-ad76-a621263bdf31

	measure 'Selected Last Activity' = FORMAT(MAX('Users'[LastActivityDate]), "yyyy-MM-dd")
		displayFolder: Profile
		lineageTag: 8a9ba164-9408-468a-92b5-0c37aa619b56

	measure 'Analysis Period Label' =
			VAR EndDate =
				CALCULATE(
					MAX('Users'[ReportRefreshDate]),
					REMOVEFILTERS('Users')
				)
			VAR StartDate = EndDate - 27
			RETURN
				IF(
					ISBLANK(EndDate),
					"Analysis window unavailable",
					"Analysis window: "
						& FORMAT(StartDate, "dd MMM yyyy")
						& " - "
						& FORMAT(EndDate, "dd MMM yyyy")
						& " | Refreshed: "
						& FORMAT(EndDate, "dd MMM yyyy")
				)
		displayFolder: Metadata
		lineageTag: f435ca48-d9d8-493e-81fc-279491cd480a

