	partition Users = m
		mode: import
		source =
				let
					Files = SharePoint.Files(SharePointSiteUrl, [ApiVersion = 15]),
					UsageFiles = Table.SelectRows(Files, each Text.EndsWith(Text.Lower([Name]), ".csv") and Text.Contains(Text.Lower([Folder Path]), Text.Lower("/" & SharePointLibraryName & "/UserSnapshots/"))),
					UsageParsed = Table.AddColumn(UsageFiles, "Rows", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])),
					UsageCombined = Table.Combine(UsageParsed[Rows]),
					UsageBlanks = Table.ReplaceValue(UsageCombined, "", null, Replacer.ReplaceValue, Table.ColumnNames(UsageCombined)),
					UsageTyped = Table.TransformColumnTypes(UsageBlanks, {{"SnapshotDate", type date}, {"ReportRefreshDate", type date}, {"ReportPeriod", Int64.Type}, {"PromptsAllApps", Int64.Type}, {"PromptsCopilotChatWork", Int64.Type}, {"PromptsCopilotChatWeb", Int64.Type}, {"ActiveUsageDays", Int64.Type}, {"LastActivityDate", type date}, {"Microsoft365CopilotLastActivityDate", type date}, {"CopilotChatLastActivityDate", type date}, {"CopilotChatWorkLastActivityDate", type date}, {"CopilotChatWebLastActivityDate", type date}, {"TeamsLastActivityDate", type date}, {"WordLastActivityDate", type date}, {"ExcelLastActivityDate", type date}, {"PowerPointLastActivityDate", type date}, {"OutlookLastActivityDate", type date}, {"OneNoteLastActivityDate", type date}, {"LoopLastActivityDate", type date}, {"EdgeLastActivityDate", type date}, {"CopilotAgentLastActivityDate", type date}}, "en-US"),
					ForD28 = Table.SelectRows(UsageTyped, each [ReportPeriod] = 28),
					LatestUsageDate = List.Max(ForD28[SnapshotDate]),
					LatestUsage = Table.SelectRows(ForD28, each [SnapshotDate] = LatestUsageDate),
					UsageCore = Table.RemoveColumns(LatestUsage, {"DisplayName", "Department", "JobTitle", "CompanyName", "OfficeLocation", "AccountEnabled", "UserType"}, MissingField.Ignore),
					DirectoryFiles = Table.SelectRows(Files, each Text.EndsWith(Text.Lower([Name]), ".csv") and Text.Contains(Text.Lower([Folder Path]), Text.Lower("/" & SharePointLibraryName & "/DirectorySnapshots/"))),
					DirectoryParsed = Table.AddColumn(DirectoryFiles, "Rows", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), [PromoteAllScalars = true])),
					DirectoryCombined = Table.Combine(DirectoryParsed[Rows]),
					DirectoryBlanks = Table.ReplaceValue(DirectoryCombined, "", null, Replacer.ReplaceValue, Table.ColumnNames(DirectoryCombined)),
					DirectoryTyped = Table.TransformColumnTypes(DirectoryBlanks, {{"SnapshotDate", type date}, {"AccountEnabled", type logical}}, "en-US"),
					LatestDirectoryDate = List.Max(DirectoryTyped[SnapshotDate]),
					LatestDirectory = Table.SelectRows(DirectoryTyped, each [SnapshotDate] = LatestDirectoryDate),
					Joined = Table.NestedJoin(UsageCore, {"UserPrincipalName"}, LatestDirectory, {"UserPrincipalName"}, "Directory", JoinKind.LeftOuter),
					Expanded = Table.ExpandTableColumn(Joined, "Directory", {"DisplayName", "Department", "JobTitle", "CompanyName", "OfficeLocation", "AccountEnabled", "UserType"}, {"DirectoryDisplayName", "Department", "JobTitle", "CompanyName", "OfficeLocation", "AccountEnabled", "UserType"}),
					WithDisplayName = Table.AddColumn(Expanded, "DisplayName", each if [DirectoryDisplayName] <> null then [DirectoryDisplayName] else [ReportDisplayName], type text),
					Cleaned = Table.RemoveColumns(WithDisplayName, {"DirectoryDisplayName", "ReportDisplayName"}, MissingField.Ignore)
				in
					Cleaned

	annotation PBI_ResultType = Exception

